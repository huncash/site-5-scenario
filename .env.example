PORT=5100

# Hétvégi zárás. Hétfőn: false / 0 — a nyilvános felület kód nélkül nyílik.
# VITE_MAINTENANCE_MODE=true
# Admin kulcs — a kliens csak a hash-t kapja (vite.config). Ne commitold.
# ADMIN_PASSPHRASE=
# VITE_ADMIN_PASSPHRASE_HASH=

# bill.szcenario.hu — külön folyamat (npm run bill:dev / bill:start), port 5110
BILL_PORT=5110
BILL_PUBLIC_URL=https://bill.szcenario.hu
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Éles (NODE_ENV=production vagy BARION_ENV=prod): mindhárom kötelező, hiány esetén hangos hiba
BARION_POS_KEY=
BARION_POSKEY=
BARION_PIXEL_ID=
BARION_ENV=test
SZAMLAZZ_AGENT_KEY=
SZAMLAKEZELO_AGENT_KEY=
# true = teszt/sandbox; false = éles Agent XML API (nincs DB-TEST mock)
SZAMLAZZ_SANDBOX=false
SZAMLA_FELESZO_EMAIL=
SZAMLAZZ_VAT=27
TRANSFER_IBAN=
TRANSFER_ACCOUNT_NAME=
TRANSFER_BANK=
NAV_LOOKUP_URL=
BARION_PAYEE=
BILL_TRANSFER_SECRET=

# support.szcenario.hu — SPA (npm run support:dev), port 5120; prod: static-origin Host → sites/support
# docs.szcenario.hu — placeholder (prod Host → sites/docs); local SITE_KEY=docs vagy port 5121
# blog.szcenario.hu — placeholder (prod Host → sites/blog); local SITE_KEY=blog vagy port 5122
# VITE_YT_LECKE_01=  # YouTube videóazonosító; üresen a VPS nem tárol videót

# school.szcenario.hu — ugyanaz a 5100 / main root; Host clamp (1 Case / 2 Slot)
# DNS: npm run dns:school
# CF_API_TOKEN=
# CF_ZONE_ID=
# CF_ZONE_NAME=szcenario.hu
# SCHOOL_A_IP=195.228.152.141

# P2P signaling (npm run signaling), port 5130 — ne a PORT=5100-at használja
# SIGNALING_PORT=5130

